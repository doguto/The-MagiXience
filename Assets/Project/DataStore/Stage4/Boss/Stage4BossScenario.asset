  - function: ShowCastMessage
    args:
    - "\u30A6\u30B7\u30C8\u30E9"
    - "\u3068\u3082\u3059\u308C\u3070\u3001\u4ED6\u4E8C\u4EBA\u3082\u2026\u2026\u3002\n\u4ED6\u306E\"\u62C5\u3044\u624B\"\u306B\u3082\u9023\u7D61\u3092\u3057\u3066\u307F\u307E\u3059\u3002"
