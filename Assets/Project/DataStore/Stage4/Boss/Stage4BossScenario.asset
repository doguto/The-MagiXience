  - function: ShowCastMessage
    args:
    - "\u30A6\u30B7\u30C8\u30E9"
    - "\u2026\u2026\u2026\u2026\uFF01\uFF1F\n\u2026\u2026\u3044\u3084\u3001\u307E\u3055\u304B\u3002\u5FDC\u7B54\u304C\u306A\u3044\uFF01\uFF1F"
  - function: ChangeCastAnimation
    args:
    - "\u30A6\u30B7\u30C8\u30E9"
    - Default
  - function: ShowCastMessage
    args:
    - "\u30A6\u30B7\u30C8\u30E9"
    - "\u5148\u751F\u3060\u3051\u306A\u3089\u307E\u3060\u3057\u3082\u3001\u304A\u5B22\u69D8\u3068\n\u9023\u7D61\u304C\u53D6\u308C\u306A\u3044\u3053\u3068\u306A\u3069\u304B\u3064\u3066\u2026\u2026\u3002"
  - function: ChangeCastAnimation
    args:
    - "\u30C6\u30F3"
    - Default
  - function: ShowCastMessage
    args:
    - "\u30C6\u30F3"
    - "\u2026\u2026\u3084\u306F\u308A\u304B\u3002\u3064\u307E\u308A\u3001\u3042\u306E\u4E8C\u4EBA\u3068\u3082\n\u6226\u3046\u3053\u3068\u306B\u306A\u308B\u304B\u3082\u3057\u308C\u306A\u3044\u3068\u3044\u3046\u3053\u3068\u3002"
  - function: ChangeCastAnimation
    args:
    - "\u30C6\u30F3"
    - Additional
  - function: ShowCastMessage
    args:
    - "\u30C6\u30F3"
    - "\u3082\u3046\u8A00\u8449\u3092\u4EA4\u308F\u3059\u6687\u3082\u306A\u3055\u305D\u3046\u3060\u3002\n\u65E5\u98DF\u304C\u8FEB\u308B\u306B\u3064\u308C\u3066\u66B4\u8D70\u3082\u52A0\u901F\u3059\u308B\u3002"
  - function: ShowCastMessage
    args:
    - "\u30C6\u30F3"
    - "\u4E8B\u614B\u304C\u3053\u308C\u4EE5\u4E0A\u60AA\u304F\u306A\u308B\u524D\u306B\u3001\n\u6C7A\u7740\u3092\u3064\u3051\u306A\u3044\u3068\u3044\u3051\u306A\u3044\u3002"
  - function: ChangeCastAnimation
    args:
    - "\u30A6\u30B7\u30C8\u30E9"
    - Default
  - function: ShowCastMessage
    args:
    - "\u30A6\u30B7\u30C8\u30E9"
    - "\u2026\u2026\u52FF\u8AD6\u3001\u627F\u77E5\u306E\u3053\u3068\u3068\u306F\u601D\u3044\u307E\u3059\u304C\u3001\n\u4E8C\u4EBA\u306F\u5B9F\u529B\u8005\u3002"
  - function: ShowCastMessage
    args:
    - "\u30A6\u30B7\u30C8\u30E9"
    - "\u3042\u306A\u305F\u304C\u76F8\u5F53\u5F37\u3044\u3068\u3057\u3066\u3082\u3001\n\u4E94\u5206\u2026\u2026\u3082\u3057\u304F\u306F\u305D\u308C\u4EE5\u4E0B\u304B\u3082\u3057\u308C\u306A\u3044\u3002"
  - function: ChangeCastAnimation
    args:
    - "\u30A6\u30B7\u30C8\u30E9"
    - Smile
  - function: ShowCastMessage
    args:
    - "\u30A6\u30B7\u30C8\u30E9"
    - "\u52A0\u3048\u3066\u3001\u76EE\u4E0B\u306F\u7570\u5E38\u4E8B\u614B\u3002\n\u66B4\u8D70\u4E2D\u306E\u5F7C\u3089\u304C\u3069\u308C\u307B\u3069\u5F37\u3044\u304B\u306F\u672A\u77E5\u6570\u3002"
  - function: ChangeCastAnimation
    args:
    - "\u30A6\u30B7\u30C8\u30E9"
    - Default
  - function: ShowCastMessage
    args:
    - "\u30A6\u30B7\u30C8\u30E9"
    - "\u2026\u2026\u305D\u308C\u3067\u3082\u3001\u5F81\u304F\u306E\u3067\u3059\u306D\u3002\n\u3053\u306E\u30BB\u30AB\u30A4\u306E\u7834\u6EC5\u3092\u53D7\u3051\u5165\u308C\u308B\u3053\u3068\u306A\u304F\u3002"
  - function: ChangeCastAnimation
    args:
    - "\u30A6\u30B7\u30C8\u30E9"
    - Smile
  - function: ShowCastMessage
    args:
    - "\u30A6\u30B7\u30C8\u30E9"
    - "\u2026\u2026\u3054\u6B66\u904B\u3092\u3002\n\u6708\u306E\u56FD\u306E\u672A\u6765\u3092\u3001\u3069\u3046\u304B\u6551\u3063\u3066\u4E0B\u3055\u3044\u2026\u2026\uFF01"
