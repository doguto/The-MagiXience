  - function: ShowCastMessage
    args:
    - "\u30A6\u30B7\u30C8\u30E9"
    - "\u306A\u308B\u307B\u3069\u3001\u30A2\u30BA\u30DE\u3082\u50D5\u3068\u540C\u3058\u3088\u3046\u306B\u2026\u2026\u3002\n\u592A\u967D\u306E\u56FD\u306E\u6C11\u306F\u6BD4\u8F03\u7684\u8EFD\u50B7\u306A\u306E\u3067\u3057\u3087\u3046\u304B\u3002"
  - function: ShowCastMessage
    args:
    - "\u30A6\u30B7\u30C8\u30E9"
    - "\u2026\u2026\u3054\u5B58\u77E5\u304B\u3068\u601D\u3044\u307E\u3059\u304C\u3001\n\u6708\u306E\u56FD\u306E\"\u62C5\u3044\u624B\"\u306F\u56DB\u4EBA\u3002"
