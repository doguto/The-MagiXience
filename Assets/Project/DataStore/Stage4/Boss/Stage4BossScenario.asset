  - function: ShowCastMessage
    args:
    - "\u30A6\u30B7\u30C8\u30E9"
    - "\u2026\u2026\u305D\u306E\u53EF\u80FD\u6027\u304C\u904E\u308B\u307B\u3069\u306E\n\u7570\u5E38\u4E8B\u614B\u306A\u306E\u3067\u3059\u306D\u3002"
