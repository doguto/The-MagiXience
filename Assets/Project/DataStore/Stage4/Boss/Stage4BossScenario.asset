  - function: ShowCastMessage
    args:
    - "\u30A6\u30B7\u30C8\u30E9"
    - "\u2026\u2026\u52FF\u8AD6\u3001\u627F\u77E5\u306E\u3053\u3068\u3068\u306F\u601D\u3044\u307E\u3059\u304C\u3001\n\u3042\u3068\u4E8C\u4EBA\u306F\u76F8\u5F53\u306A\u624B\u7DF4\u308C\u3067\u3059\u3002"
  - function: ShowCastMessage
    args:
    - "\u30A6\u30B7\u30C8\u30E9"
    - "\u666E\u6BB5\u306F\u983C\u308A\u306B\u306A\u308B\u304A\u4E8C\u65B9\u3067\u3059\u304C\u3001\n\u76EE\u4E0B\u306F\u7570\u5E38\u4E8B\u614B\u3002"
  - function: ShowCastMessage
