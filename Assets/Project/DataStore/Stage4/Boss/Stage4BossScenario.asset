    args:
    - "\u30A6\u30B7\u30C8\u30E9"
    - "\u3068\u3082\u3059\u308C\u3070\u3001\u5FF5\u306E\u305F\u3081\u306B\n\u5F7C\u3089\u306B\u9023\u7D61\u3092\u3057\u3066\u307F\u307E\u3059\u3002"
