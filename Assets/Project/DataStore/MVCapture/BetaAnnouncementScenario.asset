    - "\u30ED\u30B3"
    - "\u3048\u3048\u3002\u9577\u3089\u304F\u304A\u5F85\u305F\u305B\u3057\u3066\u3057\u307E\u3063\u305F\u308F\u306D\u3002\n\u3053\u306E\u5EA6\u2026\u2026\u3002"
  - function: ChangeCastAnimation
    args:
    - "\u30ED\u30B3"
    - Smile
  - function: ShowCastMessage
    args:
    - "\u30ED\u30B3"
    - "\"\u9B54\u79D1\u30BB\u30AB\u30A4\u3068\u7686\u65E2\u65E5\u98DF\"\u306E\n\u03B2\u7248\u3092\u767A\u8868\u3057\u307E\u3059\uFF01"
  - function: ChangeCastAnimation
    args:
    - "\u30C6\u30F3"
    - Additional
  - function: ShowCastMessage
    args:
    - "\u30C6\u30F3"
    - "\u306A\u3001\u4F55\uFF01\uFF1F\u30D9\u30FC\u30BF\u7248\u2026\u2026\uFF01\uFF1F\n\u3061\u3083\u3093\u3068\u5236\u4F5C\u9032\u3093\u3067\u305F\u306E\u304B\u2026\u2026\u3002"
  - function: ChangeCastAnimation
    args:
    - "\u30ED\u30B3"
    - Default
  - function: ShowCastMessage
    args:
    - "\u30ED\u30B3"
    - "\u5F53\u7136\u3088\uFF01\u4ECA\u56DE\u306E\u03B2\u7248\u3067\u306F\u4E11\u4E09\u30C4\u6642\u3001\n4\u9762\u307E\u3067\u306E\u7269\u8A9E\u304C\u5B9F\u88C5\u3055\u308C\u308B\u306E\u3002"
  - function: ShowCastMessage
    args:
    - "\u30ED\u30B3"
    - "1\u9762\u3088\u308A\u3082\u3055\u3089\u306B\u624B\u5F37\u3044\u30DC\u30B9\u3001\n\u65B0\u3057\u3044\u30AE\u30DF\u30C3\u30AF\u3082\u305F\u304F\u3055\u3093\u767B\u5834\u3059\u308B\u308F\uFF01"
  - function: ChangeCastAnimation
    args:
    - "\u30C6\u30F3"
    - Default
  - function: ShowCastMessage
    args:
    - "\u30C6\u30F3"
    - "\u305D\u308C\u306F\u2026\u2026\n\u697D\u3057\u307F\u3060\u304C\u3001\u56F0\u308B\u306A\u2026\u2026\u3002"
  - function: ShowCastMessage
    args:
    - "\u30C6\u30F3"
    - "\u8CB4\u65B9\u3092\u5012\u3059\u306E\u306B\u3082\u5C11\u3005\u82E6\u52B4\u3057\u305F\u3093\u3060\u3002\n\u3088\u308A\u96E3\u3057\u3044\u3068\u306A\u308C\u3070\u7A81\u7834\u3067\u304D\u308B\u304B\u2026\u2026\u3002"
  - function: ChangeCastAnimation
    args:
    - "\u30ED\u30B3"
    - Smile
  - function: ShowCastMessage
    args:
    - "\u30ED\u30B3"
    - "\u3075\u3075\u3075\u2026\u2026\u3002\u305D\u3093\u306A\u3053\u3068\u3082\u3042\u308D\u3046\u304B\u3068\u3001\n\u30B3\u30F3\u30C6\u30A3\u30CB\u30E5\u30FC\u6A5F\u80FD\u3092\u5F37\u5316\u3057\u305F\u308F\uFF01"
  - function: ChangeCastAnimation
    args:
    - "\u30ED\u30B3"
    - Default
  - function: ShowCastMessage
    args:
    - "\u30ED\u30B3"
    - "\u7E70\u308A\u8FD4\u3057\u6311\u3093\u3060\u3068\u304D\u306B\n\u3088\u308A\u8E0F\u307F\u3068\u3069\u307E\u308A\u3084\u3059\u304F\u306A\u308B\u306E\u3002"
  - function: ChangeCastAnimation
    args:
    - "\u30C6\u30F3"
    - Additional
  - function: ShowCastMessage
    args:
    - "\u30C6\u30F3"
    - "\u305D\u308C\u306A\u3089\u3053\u308C\u304B\u3089\u5148\u306B\n\u96E3\u6575\u304C\u73FE\u308C\u3066\u3082\u5B89\u5FC3\u3060\u306A\u3002"
  - function: ChangeCastAnimation
    args:
    - "\u30ED\u30B3"
    - Smile
  - function: ShowCastMessage
    args:
    - "\u30ED\u30B3"
    - "\u8155\u304C\u7ACB\u3064\u30A2\u30CA\u30BF\u306F\u3001\u3082\u3061\u308D\u3093\n\u30CE\u30FC\u30B3\u30F3\u30C6\u30A3\u30CB\u30E5\u30FC\u3084\u30CE\u30FC\u30C0\u30E1\u30FC\u30B8\u306A\u3069\u3001"
  - function: ShowCastMessage
    args:
    - "\u30ED\u30B3"
    - "\u3088\u308A\u9AD8\u307F\u3092\u76EE\u6307\u3057\u3066\u30D7\u30EC\u30A4\u3057\u3066\u307F\u3066\u306D\u3002\n\u8DB3\u8DE1\u306F\u5206\u304B\u308B\u3088\u3046\u306B\u3057\u3066\u304A\u304F\u308F\u266A"
  - function: ChangeCastAnimation
    args:
    - "\u30C6\u30F3"
    - Default
  - function: ShowCastMessage
    args:
    - "\u30C6\u30F3"
    - "\u7A81\u7834\u5831\u544A\u3084\u611F\u60F3\u306A\u3069\u306F#\u9B54\u79D1\u30BB\u30AB\u30A4\u3067\n\u767A\u4FE1\u3057\u3066\u304F\u308C\u308B\u3068\u89B3\u6E2C\u3057\u3084\u3059\u3044\u3002"
  - function: ChangeCastAnimation
    args:
    - "\u30ED\u30B3"
    - Default
  - function: ShowCastMessage
    args:
    - "\u30ED\u30B3"
    - "\u3042\u3001\u305D\u3046\u305D\u3046\u3002\u4ECA\u6D41\u308C\u3066\u3044\u308B\u66F2\u3092\u306F\u3058\u3081\u3001\n\u5192\u967A\u3092\u5F69\u308B\u97F3\u697D\u306B\u3064\u3044\u3066\u3082\u3001"
  - function: ShowCastMessage
    args:
    - "\u30ED\u30B3"
    - "\u30B5\u30A6\u30F3\u30C9\u30EB\u30FC\u30E0\u3084\u52D5\u753B\u306A\u3069\u3067\u3001\u3044\u3064\u3067\u3082\n\u8074\u3051\u308B\u3088\u3046\u306B\u3057\u3066\u304A\u304F\u304B\u3089\u3002"
  - function: ChangeCastAnimation
    args:
    - "\u30C6\u30F3"
    - Additional
  - function: ShowCastMessage
    args:
    - "\u30C6\u30F3"
    - "\u3088\u308D\u3057\u304F\u983C\u3080\u3088\u3002\n\u2026\u2026\u65E9\u901F\u3001\u65C5\u7ACB\u3064\u6E96\u5099\u3092\u3057\u306A\u3044\u3068\u306A\u3002"
  - function: ChangeCastAnimation
    args:
    - "\u30ED\u30B3"
    - Smile
  - function: ShowCastMessage
    args:
    - "\u30ED\u30B3"
    - "\u5192\u967A\u306E\u7D9A\u304D\u306F\u4ECA\u3059\u3050\uFF01\n\u30C4\u30A4\u30FC\u30C8\u5185\u306E\u30EA\u30F3\u30AF\u304B\u3089\u3088\u308D\u3057\u304F\u306D\u266A"
