  - function: ShowCastMessage
    args:
    - "\u30BF\u30C4\u30DF"
    - "\u3068\u3001\u3059\u308B\u3068\u3001\u3053\u306E\u4EEE\u8AAC\u306F\u5408\u3063\u3066\u3044\u305D\u3046\u3002\n\u3067\u3001\u3042\u308C\u3070\u2026\u2026\u3002"
