    args:
    - "\u30BF\u30C4\u30DF"
    - Additional
  - function: ShowCastMessage
    args:
    - "\u30BF\u30C4\u30DF"
    - "\u3055\u3063\u304D\u3001\u79C1\u306B\u9B54\u529B\u66B4\u8D70\u304C\u306A\u3044\u3001\u3068\u8A00\u3063\u305F\u306E\u306F\n\u304A\u305D\u3089\u304F\u3001\u5C11\u3057\u6B63\u78BA\u3067\u306F\u306A\u3044\u3093\u3060\u3002"
  - function: ChangeCastAnimation
    args:
    - "\u30BF\u30C4\u30DF"
    - Angry
  - function: ShowCastMessage
    args:
    - "\u30BF\u30C4\u30DF"
    - "\u30ED\u30B3\u3061\u3083\u3093\u3084\u79C1\u3068\u304B\u2026\u2026\u3001\n\u592A\u967D\u306E\u56FD\u306E\u6C11\u306F\u3001\u9B54\u529B\u66B4\u8D70\u306E\u5F71\u97FF\u304C\u5C0F\u3055\u3044\u3002"
  - function: ChangeCastAnimation
    args:
    - "\u30BF\u30C4\u30DF"
    - Additional
  - function: ShowCastMessage
    args:
    - "\u30BF\u30C4\u30DF"
    - "\u305D\u3057\u3066\u3001\u305F\u3076\u3093\u306D\u3002\n\u7279\u5225\u3001\u541B\u306B\u306F\u9B54\u529B\u66B4\u8D70\u306E\u5F71\u97FF\u304C\u306A\u3044\u3002"
  - function: ChangeCastAnimation
    args:
    - "\u30BF\u30C4\u30DF"
    - Angry
  - function: ShowCastMessage
    args:
    - "\u30BF\u30C4\u30DF"
    - "\u304A\u305D\u3089\u304F\u3060\u3051\u3069\u3002\u5272\u5408\u2026\u2026\u3002\n\"\u516B\u5366\u306E\u62C5\u3044\u624B\"\u3068\u3057\u3066\u306E\u529B\u306E\u5927\u5143\u306B\u3001"
