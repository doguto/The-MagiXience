  - function: ShowCastMessage
    args:
    - "\u30BF\u30C4\u30DF"
    - "\u3053\u308C\u3063\u3066\u30EF\u30BF\u30B7\u3082\u5E74\u8CA2\u306E\u7D0D\u3081\u3069\u304D\u3063\u3066\u3084\u3064\uFF1F\n\u77ED\u3044\u4EBA\u751F\u3060\u3063\u305F\u306D\u2026\u2026\u3002\u3088\u3088\u3088\u2026\u2026\u3002"
  - function: ChangeCastAnimation
    args:
    - "\u30C6\u30F3"
    - Additional
  - function: ShowCastMessage
    args:
    - "\u30C6\u30F3"
    - "\u66B4\u98A8\u306F\u306A\u3044\u306E\u306B\u76F8\u5909\u308F\u3089\u305A\u3084\u304B\u307E\u3057\u3044\u2026\u2026\u3002\n\u3044\u3084\u3001\u4E45\u3057\u3044\u306A\u3001\u30BF\u30C4\u30DF\u3002\u8CEA\u554F\u304C\u3042\u308B\u3002"
  - function: ChangeCastAnimation
    args:
