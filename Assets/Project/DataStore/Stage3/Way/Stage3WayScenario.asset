    args:
    - "\u30BF\u30C4\u30DF"
    - Angry
  - function: ShowCastMessage
    args:
    - "\u30BF\u30C4\u30DF"
    - "\u3053\u306E\u6C17\u8C61\u73FE\u8C61\u304C\u306A\u305C\u8D77\u3053\u3063\u305F\u306E\u304B\u306F\n\u79C1\u306B\u3082\u4E0D\u660E\u3060\u3051\u3069\u2026\u2026\u3002"
  - function: TypeWriter
    args:
    - true
    - 40
  - function: ChangeCastAnimation
    args:
    - "\u30BF\u30C4\u30DF"
    - Default
  - function: ShowCastMessage
    args:
    - "\u30BF\u30C4\u30DF"
    - "\u3053\u308C\u304C\u79C1\u305F\u3061\u306E\u6839\u6E90\u3068\u306A\u308B\u9670\u967D\u306E\u529B\u3092\n\u5927\u304D\u304F\u63FA\u308B\u304C\u3057\u3066\u3044\u308B\u306E\u306B\u306F\u9055\u3044\u306A\u3044\u30CF\u30BA\u3002"
