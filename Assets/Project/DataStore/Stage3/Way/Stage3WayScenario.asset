    - Angry
  - function: ShowCastMessage
    args:
    - "\u30C6\u30F3"
    - "\u3053\u306E\u65E5\u98DF\u306F\u4F55\u3060\uFF1F\u305D\u306E\u602A\u6211\u306F\u3069\u3046\u3057\u305F\uFF1F\n\u4F55\u6545\u541B\u306B\u306F\u9B54\u529B\u66B4\u8D70\u304C\u767A\u751F\u3057\u3066\u3044\u306A\u3044\uFF1F"
  - function: ChangeCastAnimation
    args:
    - "\u30BF\u30C4\u30DF"
    - Default
  - function: ShowCastMessage
    args:
    - "\u30BF\u30C4\u30DF"
    - "\u3075\u3080\u3001\u305D\u306E\u69D8\u5B50\u3060\u3068\u4F55\u304C\u8D77\u304D\u3066\u3044\u308B\u304B\u306F\n\u5206\u304B\u3063\u3066\u308B\u3051\u3069\u3001\u539F\u56E0\u4E0D\u660E\u3063\u3066\u611F\u3058\uFF1F"
  - function: ChangeCastAnimation
    args:
    - "\u30C6\u30F3"
    - Additional
  - function: ShowCastMessage
    args:
    - "\u30C6\u30F3"
    - "\u3042\u3042\u3002\u305D\u3057\u3066\u3001\u305D\u306E\u7B54\u3048\u306B\u4E00\u756A\u8FD1\u3065\u3051\u308B\u306E\u306F\n\u541B\u306E\u982D\u8133\u3060\u3068\u3044\u3046\u3053\u3068\u3082\u5206\u304B\u3063\u3066\u3044\u308B\u3002"
  - function: ChangeCastAnimation
    args:
    - "\u30BF\u30C4\u30DF"
    - Default
  - function: ShowCastMessage
    args:
    - "\u30BF\u30C4\u30DF"
    - "\u3048\u3078\u3001\u983C\u308A\u306B\u3057\u3066\u304F\u308C\u3066\u308B\u3058\u3083\u3093\u3002\n\u305D\u3046\u3060\u306D\u3001\u4E00\u3064\u4E00\u3064\u89E3\u660E\u3057\u3088\u3046\u304B\u3002"
  - function: AutoAdvance
