    - Default
  - function: ShowCastMessage
    args:
    - "\u30BF\u30C4\u30DF"
    - "\u592A\u967D\u5149\u306E\u3001\u6708\u306B\u3088\u308B\u906E\u65AD\u2026\u2026\u3002\n\u541B\u304C\u8A00\u3046\u3068\u3053\u308D\u306E\u65E5\u98DF\u3060\u306D\u3002"
