    - "\u30BF\u30C4\u30DF"
    - Default
  - function: ShowCastMessage
    args:
    - "\u30BF\u30C4\u30DF"
    - "\u6708\u3001\u9670\u306E\u529B\u7531\u6765\u306E\u9B54\u529B\u3092\u3042\u307E\u308A\u6301\u305F\u306A\u3044\u3001\n\u3082\u3057\u304F\u306F\u5168\u304F\u6301\u305F\u306A\u3044\u3053\u3068\u3002\u3053\u308C\u304C"
  - function: ShowCastMessage
    args:
    - "\u30BF\u30C4\u30DF"
    - "\u66B4\u8D70\u306E\u8868\u51FA\u306E\u4ED5\u65B9\u306B\u5DEE\u304C\u751F\u307E\u308C\u3066\u3044\u308B\n\u539F\u56E0\u3058\u3083\u306A\u3044\u304B\u306A\u3001\u3063\u3066\u63A8\u5BDF\u3057\u3066\u308B\u3002"
