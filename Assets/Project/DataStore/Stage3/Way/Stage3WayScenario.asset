    - "\u30BF\u30C4\u30DF"
    - "\u30A4\u30C6\u30C6\u306A\u3093\u3060\u3051\u3069\u30FC\u3063\uFF01\n\u3057\u304B\u3082\u76EE\u306E\u524D\u306B\u306F\u30C6\u30F3\u304F\u3093\u304C\uFF01"
