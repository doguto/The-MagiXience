  - function: ShowCastMessage
    args:
    - "\u30BF\u30C4\u30DF"
    - "\u2026\u2026\u4ED5\u4E8B\u71B1\u5FC3\u3068\u3044\u3046\u304B\u3001\u56DB\u89D2\u56DB\u9762\u3068\u3044\u3046\u304B\u3002\n\u30A2\u30A4\u30BF\u30BF\u30BF\u3001\u76F8\u5909\u308F\u3089\u305A\u5BB9\u8D66\u306A\u3044\u306D\u30FC\u2026\u2026\u3002"
  - function: ChangeCastAnimation
    args:
    - "\u30BF\u30C4\u30DF"
    - Default
  - function: ShowCastMessage
    args:
    - "\u30BF\u30C4\u30DF"
    - "\u3067\u3082\u3001\u30A8\u30CD\u30EB\u30AE\u30FC\u3067\u9B54\u529B\u304C\u76F8\u6BBA\u3055\u308C\u308B\u611F\u899A\u3001\n\u306A\u308B\u307B\u3069\u3053\u3093\u306A\u611F\u3058\u306A\u3093\u3060\u306D\u2026\u2026\uFF01"
  - function: ShowCastMessage
    args:
    - "\u30BF\u30C4\u30DF"
    - "\u30EF\u30BF\u30B7\u305F\u3061\u306E\u6301\u3064\u529B\u306B\u3064\u3044\u3066\u306E\u7406\u89E3\u304C\n\u5C11\u3057\u6DF1\u307E\u3063\u305F\u6C17\u304C\u3059\u308B\u3088\uFF01"
  - function: ChangeCastAnimation
    args:
    - "\u30BF\u30C4\u30DF"
    - Additional
  - function: ShowCastMessage
    args:
    - "\u30BF\u30C4\u30DF"
    - "\u3068\u3068\u3001\u305D\u3093\u306A\u3053\u3068\u8A00\u3063\u3066\u3044\u308B\u5834\u5408\u3058\u3083\n\u306A\u304B\u3063\u305F\u306D\u3002"
  - function: ChangeCastAnimation
    args:
    - "\u30C6\u30F3"
    - Additional
  - function: ShowCastMessage
    args:
    - "\u30C6\u30F3"
    - "\u3042\u3042\u3001\u4ED6\u306E\"\u62C5\u3044\u624B\"\u305F\u3061\u306B\u3082\u3001\n\u30A8\u30CD\u30EB\u30AE\u30FC\u3092\u6253\u3061\u8FBC\u307E\u306A\u3044\u3068\u306A\u3002"
  - function: ShowCastMessage
    args:
    - "\u30C6\u30F3"
    - "\u2026\u2026\u305D\u3046\u3044\u3048\u3070\u3001\u521D\u3081\u304B\u3089\u5C11\u3057\u602A\u6211\u3092\n\u3057\u3066\u3044\u305F\u306E\u306F\u3082\u3057\u304B\u3057\u3066\u541B\u3082\uFF1F"
  - function: ChangeCastAnimation
    args:
    - "\u30BF\u30C4\u30DF"
    - Angry
  - function: ShowCastMessage
    args:
    - "\u30BF\u30C4\u30DF"
    - "\u305D\u306E\u901A\u308A\u3002\u2026\u2026\u3048\u3063\u3068\u3001\u77E5\u308A\u5408\u3044\u304C\u306D\u3001\n\u4E01\u5EA6\u9B54\u529B\u66B4\u8D70\u3092\u8D77\u3053\u3057\u3066\u3055\u3002"
  - function: ChangeCastAnimation
    args:
    - "\u30BF\u30C4\u30DF"
    - Additional
  - function: ShowCastMessage
    args:
    - "\u30BF\u30C4\u30DF"
    - "\u52A9\u3051\u3088\u3046\u3068\u3057\u305F\u3093\u3060\u3051\u3069\u3001\u77E5\u3063\u3066\u306E\u901A\u308A\u3001\n\u30EF\u30BF\u30B7\u8155\u3063\u3077\u3057\u5F31\u3044\u304B\u3089\u3055\u3002"
  - function: ChangeCastAnimation
    args:
    - "\u30BF\u30C4\u30DF"
    - Smile
  - function: ShowCastMessage
    args:
    - "\u30BF\u30C4\u30DF"
    - "\u3054\u89A7\u306E\u3042\u308A\u3055\u307E\u3063\u3066\u30EF\u30B1\u3002\n\u3053\u308C\u306F\u5EA7\u5B66\u4EE5\u5916\u3082\u9811\u5F35\u3089\u306A\u3044\u3068\u304B\u306A\uFF5E\u3002"
  - function: ChangeCastAnimation
    args:
    - "\u30BF\u30C4\u30DF"
    - Additional
  - function: ShowCastMessage
    args:
    - "\u30BF\u30C4\u30DF"
    - "\u2026\u2026\u306D\u3047\u3001\u30C6\u30F3\u304F\u3093\u3002\u79C1\u306E\u4EE3\u308F\u308A\u306B\n\u5F7C\u306E\u3053\u3068\u3001\u52A9\u3051\u3066\u304D\u3066\u3088\u3002"
  - function: ChangeCastAnimation
    args:
    - "\u30C6\u30F3"
    - Default
  - function: ShowCastMessage
    args:
    - "\u30C6\u30F3"
    - "\u8A00\u308F\u308C\u306A\u304F\u3068\u3082\u306A\u3002\n\u2026\u2026\u9375\u3068\u3057\u3066\u306E\u8CAC\u52D9\u306F\u679C\u305F\u3059\u3002"
  - function: ChangeCastAnimation
