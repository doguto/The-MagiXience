    - "\u3055\u3063\u3059\u304C\u3001\u983C\u308C\u308B\u306D\u30FC\uFF01\n\u3088\u304D\u5831\u544A\u3001\u671F\u5F85\u3057\u3066\u308B\u3088\u3002"
